# Databricks CLI profile pointing at your workspace.
DATABRICKS_CONFIG_PROFILE=todo-app-dev

# Lakebase project this app connects to. Mirrors `var.lakebase_project_id`
# in databricks.yml — the deployed app gets this injected via the bundle's
# app.config.env block; local dev reads it from here.
LAKEBASE_PROJECT_ID=todo-app-v2

# Lakebase branch you want to develop against. Conventionally `dev-{first-last}`
# derived from your email. Create it once with `make branch-create NAME=dev-{first-last}`.
LAKEBASE_BRANCH_ID=dev-your-name

# Postgres schema this app creates and owns inside the Lakebase database.
# Mirrors `var.lakebase_schema` in databricks.yml.
LAKEBASE_SCHEMA=todo_app

# ── Optional overrides ──────────────────────────
# LAKEBASE_ENDPOINT_ID=primary
# LAKEBASE_DATABASE=databricks_postgres
