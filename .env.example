# Databricks CLI profile pointing at your workspace.
DATABRICKS_CONFIG_PROFILE=todo-app-dev

# Lakebase project to connect to. Mirrors the `lakebase_project_id` bundle
# variable in databricks.yml — the deployed app gets this injected through
# the bundle's app.config.env block; local dev reads it from here.
LAKEBASE_PROJECT_ID=todo-app-v2

# ── Optional overrides ──────────────────────────
# Bypass auto-detection — only set if you need to override:
#
# LAKEBASE_BRANCH_ID=dev-your-name     # default: production for SP, dev-{username} for users
# LAKEBASE_ENDPOINT_ID=primary
# LAKEBASE_DATABASE=databricks_postgres
